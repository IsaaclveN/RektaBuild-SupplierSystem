{{> head }}
<body>
{{> nav }}

<main class="page-wrap page-enter">
  <div class="page-header">
    <div>
      <div class="flex items-center gap-2.5 flex-wrap">
        <h1 class="page-title mono" style="font-size: 1.25rem;">{{order.orderNumber}}</h1>
        <span class="badge {{statusClass order.status}}">{{order.status}}</span>
      </div>
      <p class="page-subtitle">{{order.name}} · {{order.supplier.name}}</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <a href="/orders/{{order.id}}/print" class="btn btn-secondary">Print / PDF</a>
      {{#if (eq order.status "PENDING")}}
      <form method="POST" action="/orders/{{order.id}}/approve"><button type="submit" class="btn btn-primary">Approve Order</button></form>
      {{/if}}
      {{#if (eq order.status "APPROVED")}}
      <form method="POST" action="/orders/{{order.id}}/place"><button type="submit" class="btn btn-primary">Place Order</button></form>
      {{/if}}
      {{#if (eq order.status "PLACED")}}
      <a href="/orders/{{order.id}}/receive" class="btn btn-success">Receive Delivery</a>
      {{/if}}
      {{#if (eq order.status "PARTIALLY_RECEIVED")}}
      <a href="/orders/{{order.id}}/receive" class="btn btn-success">Receive Delivery</a>
      {{/if}}
      {{#if (eq order.status "RECEIVED")}}{{else}}
        {{#if (eq order.status "CANCELLED")}}{{else}}
        <form method="POST" action="/orders/{{order.id}}/cancel" data-confirm="Cancel purchase order {{order.orderNumber}}? This cannot be undone.">
          <button type="submit" class="btn btn-danger">Cancel Order</button>
        </form>
        {{/if}}
      {{/if}}
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
    <div class="lg:col-span-2 flex flex-col gap-4">
      <div class="card overflow-hidden">
        <div class="card-header">
          <h2 class="card-title">Order Line Items</h2>
        </div>
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Product</th>
                <th>Qty</th>
                <th>Received</th>
                <th>Unit Price</th>
                <th class="text-right">Total</th>
              </tr>
            </thead>
            <tbody>
              {{#each order.items}}
              <tr>
                <td>
                  <span class="mono" style="color: var(--text-muted);">{{product.productCode}}</span>
                  <span class="font-medium ml-1">{{product.name}}</span>
                  {{#if productSupplier}}<div class="text-xs" style="color: var(--text-muted);">Source: {{productSupplier.supplierCode}}</div>{{/if}}
                </td>
                <td>{{quantity}}</td>
                <td>{{quantityReceived}}</td>
                <td>{{money unitPrice}}</td>
                <td class="text-right font-medium">₱{{multiply quantity unitPrice}}</td>
              </tr>
              {{/each}}
              <tr style="background-color: var(--bg-surface-muted);">
                <td colspan="4" class="font-semibold">Grand Total</td>
                <td class="text-right font-semibold">{{money grandTotal}}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="card overflow-hidden">
        <div class="card-header">
          <h2 class="card-title">Attached Documents</h2>
        </div>
        <div class="table-wrap">
          <table class="data-table">
            <tbody>
              {{#each order.documents}}
              <tr>
                <td><a href="{{filePath}}" target="_blank" class="text-link">{{originalName}}</a></td>
                <td class="text-xs" style="color: var(--text-muted);">{{uploadedBy.name}} · {{formatDate createdAt}}</td>
                <td class="text-right">
                  <form method="POST" action="/orders/{{../order.id}}/documents/{{id}}/delete" data-confirm="Delete document {{originalName}}?">
                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                  </form>
                </td>
              </tr>
              {{else}}
              <tr>
                <td colspan="3">
                  <div class="empty-state">
                    <div class="empty-state-title">No documents attached</div>
                    <div class="empty-state-desc">Upload canvass sheets, quotations, or supporting files below.</div>
                  </div>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        <form method="POST" action="/orders/{{order.id}}/documents" enctype="multipart/form-data" class="card-body border-t flex flex-wrap items-center gap-3" style="border-color: var(--border-color);">
          <input type="file" name="document" class="text-xs" style="color: var(--text-secondary);" required />
          <button type="submit" class="btn btn-primary btn-sm">Upload Document</button>
        </form>
      </div>

      <div class="card overflow-hidden">
        <div class="card-header">
          <h2 class="card-title">Receipts</h2>
        </div>
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Receipt #</th>
                <th>Date Received</th>
                <th>Items</th>
              </tr>
            </thead>
            <tbody>
              {{#each order.receipts}}
              <tr>
                <td><a href="/receipts/{{id}}" class="mono text-link">{{receiptNumber}}</a></td>
                <td style="color: var(--text-muted);">{{formatDate dateReceived}}</td>
                <td>{{items.length}}</td>
              </tr>
              {{else}}
              <tr>
                <td colspan="3">
                  <div class="empty-state">
                    <div class="empty-state-title">No receipts yet</div>
                    <div class="empty-state-desc">Deliveries recorded against this order will appear here.</div>
                  </div>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-4">
      <div class="card">
        <div class="card-header">
          <h2 class="card-title">Order Details</h2>
        </div>
        <div class="card-body text-sm flex flex-col gap-2.5">
          <div>
            <span class="form-label mb-0">Ordered by</span>
            <span>{{#if order.orderedBy.name}}{{order.orderedBy.name}}{{else}}—{{/if}}</span>
          </div>
          <div>
            <span class="form-label mb-0">Date ordered</span>
            <span>{{formatDate order.dateOrdered}}</span>
          </div>
          <div>
            <span class="form-label mb-0">Approved by</span>
            <span>{{#if order.approvedBy.name}}{{order.approvedBy.name}}{{else}}—{{/if}}</span>
          </div>
          <div>
            <span class="form-label mb-0">Date approved</span>
            <span>{{formatDate order.dateApproved}}</span>
          </div>
          <div>
            <span class="form-label mb-0">Project / Delivery Site</span>
            <span>{{#if order.projectSite}}{{order.projectSite}}{{else}}—{{/if}}</span>
          </div>
          <div>
            <span class="form-label mb-0">Expected Delivery</span>
            <span>{{formatDate order.expectedDeliveryDate}}</span>
          </div>
          <div>
            <span class="form-label mb-0">Payment Terms</span>
            <span>{{#if order.paymentTerms}}{{order.paymentTerms}}{{else}}—{{/if}}</span>
          </div>
          {{#if order.description}}
          <div>
            <span class="form-label mb-0">Description</span>
            <p style="color: var(--text-secondary); margin: 0;">{{order.description}}</p>
          </div>
          {{/if}}
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <h2 class="card-title">Comments</h2>
        </div>
        <form method="POST" action="/orders/{{order.id}}/comments" class="card-body">
          <textarea name="comments" rows="4" class="form-control">{{order.comments}}</textarea>
          <div class="mt-3">
            <button type="submit" class="btn btn-secondary btn-sm">Save Comments</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>

{{> footer }}
