{{> head }}
<body>
{{> nav }}

<main class="page-wrap page-enter max-w-4xl">
  <div class="page-header no-print">
    <div>
      <h1 class="page-title">Purchase Order Slip</h1>
      <p class="page-subtitle">Print or choose "Save as PDF" in your browser print dialog.</p>
    </div>
    <div class="flex items-center gap-2">
      <button type="button" onclick="window.print()" class="btn btn-primary">Print / Save as PDF</button>
      <a href="/orders/{{order.id}}" class="btn btn-secondary">Back to Order</a>
    </div>
  </div>

  <div class="card print-sheet">
    <div class="card-body flex flex-col gap-6">
      <div class="flex justify-between items-start border-b pb-4" style="border-color: var(--border-color);">
        <div>
          <div class="text-lg font-bold tracking-tight">REKTABUILD CONSTRUCTION SUPPLY</div>
          <div class="text-xs" style="color: var(--text-muted);">Supplier Management &amp; Procurement</div>
        </div>
        <div class="text-right">
          <div class="text-base font-bold uppercase tracking-wide">Purchase Order</div>
          <div class="mono text-sm font-semibold">{{order.orderNumber}}</div>
          <div class="text-xs" style="color: var(--text-muted);">Status: {{order.status}}</div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 text-sm">
        <div>
          <div class="form-label mb-1">Supplier</div>
          <div class="font-semibold">{{order.supplier.name}} ({{order.supplier.code}})</div>
          {{#if order.supplier.tin}}<div class="text-xs">TIN: <span class="mono">{{order.supplier.tin}}</span></div>{{/if}}
          {{#if order.supplier.contactPerson}}<div class="text-xs">Attn: {{order.supplier.contactPerson}} {{#if order.supplier.contactPhone}}· {{order.supplier.contactPhone}}{{/if}}</div>{{/if}}
          {{#if order.supplier.locations.[0]}}
          <div class="text-xs" style="color: var(--text-secondary);">
            {{order.supplier.locations.[0].address1}}, {{order.supplier.locations.[0].city}}
          </div>
          {{/if}}
        </div>
        <div class="text-right">
          <div class="text-xs"><span class="font-semibold">Date Ordered:</span> {{formatDate order.dateOrdered}}</div>
          <div class="text-xs"><span class="font-semibold">Expected Delivery:</span> {{formatDate order.expectedDeliveryDate}}</div>
          <div class="text-xs"><span class="font-semibold">Project / Delivery Site:</span> {{#if order.projectSite}}{{order.projectSite}}{{else}}Main Warehouse{{/if}}</div>
          <div class="text-xs"><span class="font-semibold">Payment Terms:</span> {{#if order.paymentTerms}}{{order.paymentTerms}}{{else}}Net 30{{/if}}</div>
        </div>
      </div>

      <div class="table-wrap border rounded" style="border-color: var(--border-color);">
        <table class="data-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Code</th>
              <th>Item Description</th>
              <th>Unit</th>
              <th class="text-right">Qty</th>
              <th class="text-right">Unit Price</th>
              <th class="text-right">Line Total</th>
            </tr>
          </thead>
          <tbody>
            {{#each order.items}}
            <tr>
              <td>{{@index}}</td>
              <td class="mono">{{product.productCode}}</td>
              <td class="font-medium">{{product.name}}</td>
              <td>{{#if product.unitOfMeasure}}{{product.unitOfMeasure}}{{else}}PC{{/if}}</td>
              <td class="text-right">{{quantity}}</td>
              <td class="text-right">{{money unitPrice}}</td>
              <td class="text-right font-medium">₱{{multiply quantity unitPrice}}</td>
            </tr>
            {{/each}}
            <tr style="background-color: var(--bg-surface-muted);">
              <td colspan="6" class="text-right font-semibold">Grand Total</td>
              <td class="text-right font-bold">{{money grandTotal}}</td>
            </tr>
          </tbody>
        </table>
      </div>

      {{#if order.comments}}
      <div class="text-xs border-t pt-3" style="border-color: var(--border-color);">
        <span class="font-semibold">Notes / Instructions:</span> {{order.comments}}
      </div>
      {{/if}}

      <div class="grid grid-cols-3 gap-6 pt-8 text-xs text-center">
        <div>
          <div class="border-t pt-2 font-medium" style="border-color: var(--border-color);">
            {{#if order.orderedBy.name}}{{order.orderedBy.name}}{{else}}Procurement Officer{{/if}}
          </div>
          <div style="color: var(--text-muted);">Prepared By</div>
        </div>
        <div>
          <div class="border-t pt-2 font-medium" style="border-color: var(--border-color);">
            {{#if order.approvedBy.name}}{{order.approvedBy.name}}{{else}}Authorized Approver{{/if}}
          </div>
          <div style="color: var(--text-muted);">Approved By</div>
        </div>
        <div>
          <div class="border-t pt-2 font-medium" style="border-color: var(--border-color);">Supplier Conforme</div>
          <div style="color: var(--text-muted);">Signature &amp; Date</div>
        </div>
      </div>

      <div class="text-[11px] text-right" style="color: var(--text-muted);">
        Generated by RektaBuild on {{generatedAt}}
      </div>
    </div>
  </div>
</main>

{{> footer }}
