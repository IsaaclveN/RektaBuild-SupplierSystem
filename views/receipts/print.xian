{{> head }}
<body>
{{> nav }}

<main class="page-wrap page-enter max-w-4xl">
  <div class="page-header no-print">
    <div>
      <h1 class="page-title">Goods Receipt &amp; Inspection Slip</h1>
      <p class="page-subtitle">Print or choose "Save as PDF" in your browser print dialog.</p>
    </div>
    <div class="flex items-center gap-2">
      <button type="button" onclick="window.print()" class="btn btn-primary">Print / Save as PDF</button>
      <a href="/receipts/{{receipt.id}}" class="btn btn-secondary">Back to Receipt</a>
    </div>
  </div>

  <div class="card print-sheet">
    <div class="card-body flex flex-col gap-6">
      <div class="flex justify-between items-start border-b pb-4" style="border-color: var(--border-color);">
        <div>
          <div class="text-lg font-bold tracking-tight">REKTABUILD CONSTRUCTION SUPPLY</div>
          <div class="text-xs" style="color: var(--text-muted);">Material Receiving &amp; Quality Inspection</div>
        </div>
        <div class="text-right">
          <div class="text-base font-bold uppercase tracking-wide">Goods Receipt Note</div>
          <div class="mono text-sm font-semibold">{{receipt.receiptNumber}}</div>
          <div class="text-xs" style="color: var(--text-muted);">PO: <span class="mono">{{receipt.order.orderNumber}}</span></div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4 text-xs">
        <div>
          <div><span class="font-semibold">Supplier:</span> {{receipt.order.supplier.name}} ({{receipt.order.supplier.code}})</div>
          <div><span class="font-semibold">Project / Delivery Site:</span> {{#if receipt.order.projectSite}}{{receipt.order.projectSite}}{{else}}Main Warehouse{{/if}}</div>
        </div>
        <div class="text-right">
          <div><span class="font-semibold">Date Received:</span> {{formatDate receipt.dateReceived}}</div>
          <div><span class="font-semibold">Shipment / DR #:</span> {{#if receipt.shipmentNumber}}{{receipt.shipmentNumber}}{{else}}—{{/if}}</div>
          <div><span class="font-semibold">Received By:</span> {{#if receipt.receivedBy.name}}{{receipt.receivedBy.name}}{{else}}Warehouse Staff{{/if}}</div>
        </div>
      </div>

      <div class="table-wrap border rounded" style="border-color: var(--border-color);">
        <table class="data-table">
          <thead>
            <tr>
              <th>Code</th>
              <th>Material / Product</th>
              <th class="text-right">Accepted</th>
              <th class="text-right">Rejected</th>
              <th>Inspection</th>
              <th>Quality Notes</th>
            </tr>
          </thead>
          <tbody>
            {{#each receipt.items}}
            <tr>
              <td class="mono">{{product.productCode}}</td>
              <td class="font-medium">{{product.name}}</td>
              <td class="text-right font-medium">{{quantityReceived}}</td>
              <td class="text-right font-medium">{{quantityRejected}}</td>
              <td>{{inspectionStatus}}<br /><span style="font-size: 0.8em; color: #555;">Qty {{checkMark qtyMatchesPo}} · Pkg {{checkMark packagingIntact}} · Spec {{checkMark specsCorrect}} · Dmg {{checkMark noVisibleDamage}}</span></td>
              <td>{{#if comment}}{{comment}}{{else}}—{{/if}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      {{#if receipt.comments}}
      <div class="text-xs border-t pt-3" style="border-color: var(--border-color);">
        <span class="font-semibold">Delivery Comments:</span> {{receipt.comments}}
      </div>
      {{/if}}

      <div class="grid grid-cols-2 gap-8 pt-8 text-xs text-center">
        <div>
          <div class="border-t pt-2 font-medium" style="border-color: var(--border-color);">
            {{#if receipt.receivedBy.name}}{{receipt.receivedBy.name}}{{else}}Site / Warehouse Receiver{{/if}}
          </div>
          <div style="color: var(--text-muted);">Received &amp; Inspected By</div>
        </div>
        <div>
          <div class="border-t pt-2 font-medium" style="border-color: var(--border-color);">Driver / Supplier Representative</div>
          <div style="color: var(--text-muted);">Delivered By</div>
        </div>
      </div>

      <div class="text-[11px] text-right" style="color: var(--text-muted);">
        Generated by RektaBuild on {{generatedAt}}
      </div>
    </div>
  </div>
</main>

{{> footer }}
