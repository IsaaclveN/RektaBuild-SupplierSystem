{{> head}}
<body>
  <div class="flex flex-col items-center justify-center flex-1 px-4 py-12">
    <div class="mb-6 text-center">
      <div class="inline-flex items-center gap-2 mb-1">
        <span class="app-brand-mark">R</span>
        <span class="text-lg font-semibold" style="color: var(--text-primary);">RektaBuild</span>
      </div>
      <p class="text-xs" style="color: var(--text-muted);">Supplier Management System</p>
    </div>

    <div class="card card-glass w-full max-w-sm page-enter">
      <div class="card-header">
        <h1 class="card-title">Sign in</h1>
      </div>
      <form class="card-body flex flex-col gap-4" method="POST" action="/login" novalidate>
        <div>
          <label class="form-label" for="loginEmail">Email address</label>
          <input id="loginEmail" type="email" name="email" class="form-control" placeholder="you@company.com" required />
          <div class="form-error">Please enter a valid email address.</div>
        </div>
        <div>
          <label class="form-label" for="loginPassword">Password</label>
          <input id="loginPassword" type="password" name="password" class="form-control" placeholder="••••••••" required />
          <div class="form-error">Password is required.</div>
        </div>
        <button type="submit" class="btn btn-primary w-full">Sign in</button>
        <div class="flex items-center justify-between text-xs pt-1">
          <a href="/forgot-password" class="text-link">Forgot password?</a>
          <a href="/register" class="text-link">Create account</a>
        </div>
      </form>
    </div>
  </div>
{{> footer }}
