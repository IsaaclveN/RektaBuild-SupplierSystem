<div id="sidebarOverlay" class="sidebar-overlay"></div>

<aside id="appSidebar" class="app-sidebar">
  <div class="app-sidebar-brand">
    <div class="flex items-center gap-2.5 min-w-0">
      <span class="app-brand-mark">R</span>
      <div class="brand-text truncate">
        <a href="/dashboard" class="text-white font-semibold text-sm tracking-tight block leading-tight">RektaBuild</a>
        <span class="text-[11px] text-slate-400 block">Supplier Management</span>
      </div>
    </div>
    <button type="button" data-sidebar-collapse class="sidebar-collapse-btn" aria-label="Collapse sidebar" title="Collapse sidebar">
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
  </div>

  <nav class="app-nav">
    <a href="/dashboard" class="nav-link {{#if (navActive currentPath "/dashboard")}}is-active{{/if}}" title="Dashboard">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
      <span>Dashboard</span>
    </a>

    <div class="nav-group">
      <button type="button" class="nav-section-btn">
        <span>Suppliers</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="nav-submenu">
        <a href="/suppliers" class="nav-link {{#if (navActive currentPath "/suppliers")}}is-active{{/if}}" title="Suppliers">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/><path d="M9 9v.01"/><path d="M9 13v.01"/><path d="M9 17v.01"/></svg>
          <span>Suppliers</span>
        </a>
        <a href="/product-sources" class="nav-link {{#if (navActive currentPath "/product-sources")}}is-active{{/if}}" title="Product Sources">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          <span>Product Sources</span>
        </a>
      </div>
    </div>

    <div class="nav-group">
      <button type="button" class="nav-section-btn">
        <span>Procurement</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="nav-submenu">
        <a href="/orders" class="nav-link {{#if (navActive currentPath "/orders")}}is-active{{/if}}" title="Purchase Orders">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8"/><path d="M8 17h5"/></svg>
          <span>Purchase Orders</span>
        </a>
        <a href="/receipts" class="nav-link {{#if (navActive currentPath "/receipts")}}is-active{{/if}}" title="Receiving">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
          <span>Receiving</span>
        </a>
        <a href="/products" class="nav-link {{#if (navActive currentPath "/products")}}is-active{{/if}}" title="Materials Catalog">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><circle cx="7" cy="7" r="1.5"/></svg>
          <span>Materials</span>
        </a>
      </div>
    </div>

    <a href="/reports" class="nav-link {{#if (navActive currentPath "/reports")}}is-active{{/if}}" title="Reports & PDF">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
      <span>Reports &amp; PDF</span>
    </a>

    <a href="/api-keys" class="nav-link {{#if (navActive currentPath "/api-keys")}}is-active{{/if}}" title="API Keys">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="7.5" cy="15.5" r="4.5"/><path d="m10.7 12.3 8.3-8.3"/><path d="m17 6 2 2"/><path d="m14 9 2 2"/></svg>
      <span>API Keys</span>
    </a>
  </nav>

  <div class="app-sidebar-footer">
    <div class="user-pill">
      <span class="user-avatar">RB</span>
      <div class="user-meta truncate">
        {{#if currentUser}}
        <span class="text-slate-100 font-medium block truncate">{{currentUser.name}}</span>
        {{else}}
        <span class="text-slate-200 font-medium block truncate">Workspace</span>
        {{/if}}
        <span class="text-[11px] text-emerald-400 block">Online</span>
      </div>
    </div>
    <a href="/logout" class="text-slate-400 hover:text-white inline-flex items-center gap-1.5 transition-colors" title="Log out">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      <span class="logout-label">Log out</span>
    </a>
  </div>
</aside>

<header class="app-topbar">
  <div class="flex items-center gap-3 min-w-0">
    <button type="button" data-sidebar-toggle class="btn btn-ghost btn-sm mobile-menu-btn" aria-label="Toggle navigation">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
    <div class="flex items-center gap-1.5 text-xs truncate">
      <a href="/dashboard" class="text-link">Home</a>
      {{#if title}}
      <span style="color: var(--text-muted);">/</span>
      <span class="font-medium truncate" style="color: var(--text-primary);">{{title}}</span>
      {{/if}}
    </div>
  </div>

  <div class="flex items-center gap-2">
    <button type="button" data-cmd-open class="cmd-trigger" aria-label="Open command palette">
      <span class="inline-flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <span class="cmd-trigger-label">Search pages...</span>
      </span>
      <span class="kbd">Ctrl K</span>
    </button>

    <div class="dropdown">
      <button type="button" data-dropdown-toggle class="btn btn-secondary btn-sm relative" aria-label="Notifications" title="Notifications">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        <span id="notifDot" class="notif-dot" style="display:none;"></span>
      </button>
      <div class="dropdown-menu" style="min-width: 290px; padding: 0.5rem;">
        <div class="flex items-center justify-between px-2 py-1.5 mb-1 border-b" style="border-color: var(--border-color);">
          <span class="text-xs font-semibold" style="color: var(--text-primary);">Notifications</span>
          <div class="flex items-center gap-2">
            <button type="button" id="notifMarkRead" class="text-[11px] text-link bg-transparent border-0 cursor-pointer">Mark read</button>
            <button type="button" id="notifClear" class="text-[11px] bg-transparent border-0 cursor-pointer" style="color: var(--text-secondary);">Clear</button>
          </div>
        </div>
        <div id="notifList" class="flex flex-col gap-1 max-h-64 overflow-y-auto"></div>
      </div>
    </div>

    <button type="button" data-theme-toggle class="btn btn-secondary btn-sm" aria-label="Toggle color theme" title="Toggle Light / Dark mode">
      <svg data-theme-icon="moon" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <svg data-theme-icon="sun" class="w-4 h-4" style="display:none;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
    </button>

    <div class="dropdown">
      <button type="button" data-dropdown-toggle class="btn btn-secondary btn-sm" aria-label="Account menu">
        <span class="w-5 h-5 rounded-full inline-flex items-center justify-center text-[10px] font-semibold text-white" style="background: var(--accent);">RB</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="dropdown-menu">
        <div class="px-3 py-2">
          <div class="text-xs font-semibold" style="color: var(--text-primary);">{{#if currentUser}}{{currentUser.name}}{{else}}RektaBuild User{{/if}}</div>
          <div class="text-[11px]" style="color: var(--text-secondary);">{{#if currentUser}}{{currentUser.email}}{{else}}Supplier Operations{{/if}}</div>
        </div>
        <div class="dropdown-divider"></div>
        <button type="button" data-theme-toggle class="dropdown-item">
          <span>Switch Theme</span>
          <span class="kbd">Theme</span>
        </button>
        <button type="button" data-cmd-open class="dropdown-item">
          <span>Command Palette</span>
          <span class="kbd">Ctrl K</span>
        </button>
        <div class="dropdown-divider"></div>
        <a href="/logout" class="dropdown-item" style="color: var(--badge-red-text);">Log out</a>
      </div>
    </div>
  </div>
</header>

{{#if success_msg}}<div data-flash-toast="success" data-flash-message="{{success_msg}}" style="display:none;"></div>{{/if}}
{{#if error_msg}}<div data-flash-toast="error" data-flash-message="{{error_msg}}" style="display:none;"></div>{{/if}}
