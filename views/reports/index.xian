{{> head }}
<body>
{{> nav }}

<main class="page-wrap page-enter">
  <div class="page-header no-print">
    <div>
      <h1 class="page-title">Reports &amp; PDF Export</h1>
      <p class="page-subtitle">Generate printable reports and save directly as PDF for procurement, inventory, and accounting.</p>
    </div>
    <button type="button" onclick="window.print()" class="btn btn-primary">Print / Save as PDF</button>
  </div>

  <div class="card mb-4 no-print">
    <div class="card-body flex flex-col gap-4">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap gap-2">
          <a href="/reports?type=orders{{#if month}}&month={{month}}{{/if}}{{#if isAllMonths}}&month=all{{/if}}" class="btn btn-sm {{#if (eq type "orders")}}btn-primary{{else}}btn-secondary{{/if}}">Purchase Orders Report</a>
          <a href="/reports?type=suppliers" class="btn btn-sm {{#if (eq type "suppliers")}}btn-primary{{else}}btn-secondary{{/if}}">Supplier Compliance Report</a>
          <a href="/reports?type=receipts{{#if month}}&month={{month}}{{/if}}{{#if isAllMonths}}&month=all{{/if}}" class="btn btn-sm {{#if (eq type "receipts")}}btn-primary{{else}}btn-secondary{{/if}}">Receiving &amp; Quality Report</a>
        </div>

        {{#unless (eq type "suppliers")}}
        <div class="flex flex-wrap items-center gap-2">
          <a href="/reports?type={{type}}&month={{prevMonth}}" class="btn btn-secondary btn-sm" title="Previous Month">&lsaquo; Prev</a>
          <select class="form-control" style="width: auto; min-width: 165px;" onchange="if(this.value) window.location.href='/reports?type={{type}}&month='+this.value;">
            {{#each availableMonths}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
            <option value="all" {{#if isAllMonths}}selected{{/if}}>All Months</option>
          </select>
          <a href="/reports?type={{type}}&month={{nextMonth}}" class="btn btn-secondary btn-sm" title="Next Month">Next &rsaquo;</a>
        </div>
        {{/unless}}
      </div>

      <form method="GET" action="/reports" class="grid grid-cols-1 sm:grid-cols-5 gap-3 items-end">
        <input type="hidden" name="type" value="{{type}}" />
        {{#if (eq type "suppliers")}}
        <div class="sm:col-span-2">
          <label class="form-label" for="repStatus">Accreditation Status</label>
          <select id="repStatus" name="status" class="form-control">
            <option value="">All statuses</option>
            <option value="ACCREDITED" {{#if (eq status "ACCREDITED")}}selected{{/if}}>ACCREDITED</option>
            <option value="PENDING" {{#if (eq status "PENDING")}}selected{{/if}}>PENDING</option>
            <option value="PROBATION" {{#if (eq status "PROBATION")}}selected{{/if}}>PROBATION</option>
            <option value="BLACKLISTED" {{#if (eq status "BLACKLISTED")}}selected{{/if}}>BLACKLISTED</option>
          </select>
        </div>
        {{else}}
        <div>
          <label class="form-label" for="repMonth">Month</label>
          <input id="repMonth" type="month" name="month" value="{{month}}" class="form-control" />
        </div>
        <div>
          <label class="form-label" for="repFrom">Or From Date</label>
          <input id="repFrom" type="date" name="from" value="{{from}}" class="form-control" />
        </div>
        <div>
          <label class="form-label" for="repTo">Or To Date</label>
          <input id="repTo" type="date" name="to" value="{{to}}" class="form-control" />
        </div>
        <div>
          <label class="form-label" for="repSup">Supplier</label>
          <select id="repSup" name="supplierId" class="form-control">
            <option value="">All suppliers</option>
            {{#each suppliersAll}}
            <option value="{{id}}">{{name}}</option>
            {{/each}}
          </select>
        </div>
        {{/if}}
        <div class="flex gap-2">
          <button type="submit" class="btn btn-primary btn-sm">Apply</button>
          <a href="/reports?type={{type}}" class="btn btn-secondary btn-sm">Current Month</a>
        </div>
      </form>
    </div>
  </div>

  <div class="card print-sheet overflow-hidden">
    <div class="card-body border-b flex justify-between items-start" style="border-color: var(--border-color);">
      <div>
        <div class="text-base font-bold">REKTABUILD —
          {{#if (eq type "orders")}}PURCHASE ORDERS MONTHLY REPORT{{/if}}
          {{#if (eq type "suppliers")}}SUPPLIER COMPLIANCE &amp; DIRECTORY REPORT{{/if}}
          {{#if (eq type "receipts")}}RECEIVING &amp; QUALITY MONTHLY REPORT{{/if}}
        </div>
        <div class="text-xs" style="color: var(--text-muted);">
          Period: <span class="font-medium">{{monthLabel}}</span> · Generated: {{generatedAt}}
          {{#if status}} · Status: {{status}}{{/if}}
        </div>
      </div>
      <div class="text-right text-xs">
        <div><span class="font-semibold">Total Records:</span> {{summary.count}}</div>
        {{#if (eq type "orders")}}<div><span class="font-semibold">Total PO Value:</span> {{money summary.totalAmount}}</div>{{/if}}
        {{#if (eq type "receipts")}}<div><span class="font-semibold">Accepted / Rejected:</span> {{summary.totalReceived}} / {{summary.totalRejected}}</div>{{/if}}
      </div>
    </div>

    {{#unless (eq type "suppliers")}}
    <div class="card-body border-b" style="border-color: var(--border-color);">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-semibold uppercase tracking-wider" style="color: var(--text-muted);">
          Monthly Activity Graph — {{monthLabel}}
        </span>
      </div>
      <div id="reportMonthlyChart" data-report-chart='{{{chartDataJson}}}'></div>
    </div>
    {{/unless}}

    <div class="table-wrap">
      {{#if (eq type "orders")}}
      <table class="data-table">
        <thead>
          <tr>
            <th>Order #</th>
            <th>Order Name</th>
            <th>Supplier</th>
            <th>Project Site</th>
            <th>Ordered</th>
            <th>Expected</th>
            <th>Status</th>
            <th class="text-right">Total</th>
          </tr>
        </thead>
        <tbody>
          {{#each orders}}
          <tr>
            <td class="mono">{{orderNumber}}</td>
            <td class="font-medium">{{name}}</td>
            <td>{{supplier.name}}</td>
            <td>{{#if projectSite}}{{projectSite}}{{else}}—{{/if}}</td>
            <td>{{formatDate dateOrdered}}</td>
            <td>{{formatDate expectedDeliveryDate}}</td>
            <td><span class="badge {{statusClass status}}">{{status}}</span></td>
            <td class="text-right font-medium">{{money totalAmount}}</td>
          </tr>
          {{else}}
          <tr><td colspan="8" class="text-center py-6" style="color: var(--text-muted);">No matching purchase orders found.</td></tr>
          {{/each}}
        </tbody>
      </table>
      {{/if}}

      {{#if (eq type "suppliers")}}
      <table class="data-table">
        <thead>
          <tr>
            <th>Code</th>
            <th>Supplier Name</th>
            <th>TIN</th>
            <th>Terms</th>
            <th>Accreditation</th>
            <th>Permit Expiry</th>
            <th>Contact</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {{#each suppliers}}
          <tr>
            <td class="mono">{{code}}</td>
            <td class="font-medium">{{name}}</td>
            <td class="mono">{{#if tin}}{{tin}}{{else}}—{{/if}}</td>
            <td>{{#if paymentTerms}}{{paymentTerms}}{{else}}Net 30{{/if}}</td>
            <td><span class="badge {{accredClass accreditationStatus}}">{{accreditationStatus}}</span></td>
            <td>{{formatDate permitExpiry}}</td>
            <td>{{#if contactPerson}}{{contactPerson}}{{else}}—{{/if}}</td>
            <td>{{#if active}}Active{{else}}Inactive{{/if}}</td>
          </tr>
          {{else}}
          <tr><td colspan="8" class="text-center py-6" style="color: var(--text-muted);">No suppliers found.</td></tr>
          {{/each}}
        </tbody>
      </table>
      {{/if}}

      {{#if (eq type "receipts")}}
      <table class="data-table">
        <thead>
          <tr>
            <th>Receipt #</th>
            <th>Order #</th>
            <th>Supplier</th>
            <th>Date</th>
            <th>Shipment #</th>
            <th class="text-right">Accepted</th>
            <th class="text-right">Rejected</th>
            <th>Received By</th>
          </tr>
        </thead>
        <tbody>
          {{#each receipts}}
          <tr>
            <td class="mono">{{receiptNumber}}</td>
            <td class="mono">{{order.orderNumber}}</td>
            <td>{{order.supplier.name}}</td>
            <td>{{formatDate dateReceived}}</td>
            <td>{{#if shipmentNumber}}{{shipmentNumber}}{{else}}—{{/if}}</td>
            <td class="text-right font-medium">{{qtyReceivedSum}}</td>
            <td class="text-right font-medium">{{qtyRejectedSum}}</td>
            <td>{{#if receivedBy.name}}{{receivedBy.name}}{{else}}—{{/if}}</td>
          </tr>
          {{else}}
          <tr><td colspan="8" class="text-center py-6" style="color: var(--text-muted);">No matching receipts found.</td></tr>
          {{/each}}
        </tbody>
      </table>
      {{/if}}
    </div>
  </div>
</main>

{{> footer }}
