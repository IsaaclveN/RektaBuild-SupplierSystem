{{> head }}
<body>
{{> nav }}

<main class="page-wrap page-enter">
  <div class="page-header">
    <div>
      <h1 class="page-title">Product Sources</h1>
      <p class="page-subtitle">Supplier–product catalog, pricing, minimum order quantities, and lead times.</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <a href="/product-sources/export.csv" class="btn btn-secondary">Export CSV</a>
      <a href="/product-sources/new" class="btn btn-primary">+ New Source</a>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body py-3 flex flex-wrap items-center justify-between gap-3">
      <div class="text-xs" style="color: var(--text-muted);">
        <span class="font-medium" style="color: var(--text-secondary);">Bulk Import:</span> Upload a CSV matching the export template columns.
      </div>
      <form method="POST" action="/product-sources/import" enctype="multipart/form-data" class="flex flex-wrap items-center gap-2">
        <input type="file" name="csvFile" accept=".csv" class="text-xs" style="color: var(--text-secondary);" required />
        <button type="submit" class="btn btn-secondary btn-sm">Import CSV</button>
      </form>
    </div>
  </div>

  <div class="card overflow-hidden">
    <div class="table-toolbar">
      <div class="flex flex-wrap items-center gap-2 flex-1">
        <input type="text" data-table-search class="form-control" style="max-width: 280px;" placeholder="Search product or supplier..." />
        <select data-table-filter class="form-control" style="max-width: 180px;">
          <option value="">All supplier grades</option>
          <option value="OUTSTANDING">OUTSTANDING</option>
          <option value="GOOD">GOOD</option>
          <option value="FAIR">FAIR</option>
          <option value="POOR">POOR</option>
          <option value="NO_DATA">NO_DATA</option>
        </select>
      </div>
    </div>

    <div class="table-wrap">
      <table class="data-table" data-table data-page-size="10">
        <thead>
          <tr>
            <th data-sort>Product</th>
            <th data-sort>Supplier</th>
            <th data-sort>Supplier Code</th>
            <th data-sort>MOQ</th>
            <th data-sort>Lead Time</th>
            <th data-sort>Package Price</th>
            <th data-sort>Contract Price</th>
            <th data-sort>Supplier Grade</th>
            <th data-sort>Status</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each sources}}
          <tr data-row data-filter="{{performance.grade}}">
            <td><a href="/product-sources/{{id}}" class="text-link">{{product.name}}</a></td>
            <td>{{supplier.name}}</td>
            <td class="mono">{{supplierCode}}</td>
            <td>{{minOrderQuantity}}</td>
            <td style="color: var(--text-muted);">{{#if standardLeadTimeDays}}{{standardLeadTimeDays}} days{{/if}}</td>
            <td>{{money packagePrice}}</td>
            <td>
              {{money contractPrice}}
              {{#if contractPriceValidUntil}}<div class="text-xs" style="color: var(--text-muted);">until {{formatDate contractPriceValidUntil}}</div>{{/if}}
            </td>
            <td>
              <span class="badge {{gradeClass performance.grade}}">{{performance.grade}}</span>
              {{#if performance.deliveries}}
              <div class="text-xs" style="color: var(--text-muted);">
                {{performance.onTimeRate}}% on-time · {{performance.qualityRate}}% accepted
              </div>
              {{else}}
              <div class="text-xs" style="color: var(--text-muted);">No deliveries yet</div>
              {{/if}}
            </td>
            <td>
              {{#if active}}<span class="badge badge-green">Active</span>
              {{else}}<span class="badge badge-red">Inactive</span>{{/if}}
            </td>
            <td class="text-right">
              <div class="inline-flex items-center gap-2">
                <a href="/product-sources/{{id}}" class="btn btn-ghost btn-sm">View</a>
                <a href="/product-sources/{{id}}/edit" class="btn btn-secondary btn-sm">Edit</a>
              </div>
            </td>
          </tr>
          {{else}}
          <tr>
            <td colspan="10">
              <div class="empty-state">
                <div class="empty-state-title">No product sources yet</div>
                <div class="empty-state-desc">Link a product to a supplier with pricing and lead time terms.</div>
              </div>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <div class="pagination-bar" data-table-pagination></div>
  </div>
</main>

{{> footer }}
