# Runtime
NODE_ENV=development
PORT=3000
# Bind address. Leave empty for 0.0.0.0 in development; production uses 127.0.0.1
HOST=

# Session signing secret. Required when NODE_ENV=production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Demo bypass for the web session check. Ignored in production.
# Set to false to require login even in development.
AUTH_BYPASS=true

# Session cookies are Secure by default in production, which requires HTTPS.
# Set to false ONLY for a plain-HTTP / IP-only deployment, otherwise login fails.
COOKIE_SECURE=

# Comma-separated allowlist for browser calls to /api/*. Never use *.
# Example: https://inventory.example.com,https://accounting.example.com
CORS_ORIGIN=

# Database connection
DB_NAME=Rektadb
DB_USER=root
DB_PASS=
DB_HOST=localhost
DB_PORT=3306

# Set to true to print every SQL query in the terminal
DB_LOGGING=false

# ─── Inventory module integration (server-to-server) ────────────────────────
# The Inventory admin creates a reader API key in the Inventory UI (/api-keys)
# and shares it privately. Server-side only — never expose in browser JS,
# Git, URLs, or logs. Leave empty until provided.
INVENTORY_API_BASE_URL=
# Example: INVENTORY_API_BASE_URL=https://<inventory-host>/api/v1
INVENTORY_API_KEY=
# Optional tuning
# INVENTORY_API_TIMEOUT_MS=8000
# INVENTORY_API_RETRY_MAX=2
